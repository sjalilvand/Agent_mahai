# ============================================================
# npmrc-iran — قالب آماده .npmrc برای کاربران ایران
# ------------------------------------------------------------
# استفاده: این فایل را با نام .npmrc در ریشه پروژه یا در
# ~ (خانه کاربر) قرار دهید. یا فقط خط registry را دستی تنظیم کنید:
#   npm config set registry https://registry.npmjs.ir/
# ============================================================

# میرور ایرانی npm — دانلود سریع و بدون محدودیت
registry=https://registry.npmjs.ir/

# اگر میرور در دسترس نبود، این دو خط را فعال (بدون #) کنید:
# proxy=http://127.0.0.1:8118
# https-proxy=http://127.0.0.1:8118

# برای npx حین نصب بسته‌های native از گیت‌هاب، در صورت نیاز:
# (پروکسی بالا معمولاً کافی است)

# لاگ‌های کوتاه‌تر
fund=false
audit=false
